// SPDX-License-Identifier: MIT
pragma solidity ^0.8.26;

import {Test} from "forge-std/Test.sol";
import {console} from "forge-std/console.sol";

// FHE imports
import {FHE, InEuint128, InEuint64, InEuint8, euint128, euint64, euint8, ebool} from "@fhenixprotocol/cofhe-contracts/FHE.sol";
import {CoFheTest} from "@fhenixprotocol/cofhe-mock-contracts/CoFheTest.sol";

// Library under test
import {VirtualTimeEngine} from "../../src/lib/VirtualTimeEngine.sol";

contract VirtualTimeEngineTest is Test, CoFheTest {
    using VirtualTimeEngine for VirtualTimeEngine.PhantomTWAMMOrder;

    // Test constants
    uint64 constant HOUR = 3600;
    uint64 constant DAY = 24 * HOUR;
    uint128 constant INITIAL_SIZE = 1000 * 10**18;
    uint128 constant PRECISION_SCALE = 1e18;

    // Test accounts
    address trader1;
    address trader2;

    function setUp() public {
        // CoFheTest automatically sets up in constructor
        
        trader1 = makeAddr("trader1");
        trader2 = makeAddr("trader2");
    }

    // =============================================================
    // VIRTUAL TIME ADVANCEMENT TESTS (20 tests)
    // =============================================================

    function testAdvanceVirtualTime_InitialAdvancement() public {
        uint64 currentTime = uint64(block.timestamp);
        euint64 currentVTime = FHE.asEuint64(currentTime - HOUR);
        euint64 lastAdvance = FHE.asEuint64(currentTime - HOUR);
        
        FHE.allowThis(currentVTime);
        FHE.allowThis(lastAdvance);
        
        euint64 newVTime = VirtualTimeEngine.advanceVirtualTime(
            currentVTime,
            lastAdvance,
            currentTime
        );
        
        // Should advance by 1 hour
        // FHE assertion: assertTrue(FHE.decrypt(FHE.eq(newVTime, FHE.asEuint64(currentTime))));
    }

    function testAdvanceVirtualTime_NoTimeElapsed() public {
        uint64 currentTime = uint64(block.timestamp);
        euint64 currentVTime = FHE.asEuint64(currentTime);
        euint64 lastAdvance = FHE.asEuint64(currentTime);
        
        FHE.allowThis(currentVTime);
        FHE.allowThis(lastAdvance);
        
        euint64 newVTime = VirtualTimeEngine.advanceVirtualTime(
            currentVTime,
            lastAdvance,
            currentTime
        );
        
        // Should remain unchanged
        // FHE assertion: assertTrue(FHE.decrypt(FHE.eq(newVTime, currentVTime)));
    }

    function testAdvanceVirtualTime_LargeTimeGap() public {
        uint64 currentTime = uint64(block.timestamp);
        euint64 currentVTime = FHE.asEuint64(currentTime - DAY);
        euint64 lastAdvance = FHE.asEuint64(currentTime - DAY);
        
        FHE.allowThis(currentVTime);
        FHE.allowThis(lastAdvance);
        
        euint64 newVTime = VirtualTimeEngine.advanceVirtualTime(
            currentVTime,
            lastAdvance,
            currentTime
        );
        
        // Should advance by full day
        // FHE assertion: assertTrue(FHE.decrypt(FHE.eq(newVTime, FHE.asEuint64(currentTime))));
    }

    function testFuzzAdvanceVirtualTime(uint64 initialTime, uint64 elapsedTime) public {
        vm.assume(initialTime > 0 && initialTime < type(uint64).max / 2);
        vm.assume(elapsedTime < DAY * 365); // Max 1 year
        
        uint64 currentTime = initialTime + elapsedTime;
        euint64 currentVTime = FHE.asEuint64(initialTime);
        euint64 lastAdvance = FHE.asEuint64(initialTime);
        
        FHE.allowThis(currentVTime);
        FHE.allowThis(lastAdvance);
        
        euint64 newVTime = VirtualTimeEngine.advanceVirtualTime(
            currentVTime,
            lastAdvance,
            currentTime
        );
        
        // Should advance by elapsed time
        // FHE assertion: assertTrue(FHE.decrypt(FHE.eq(newVTime, FHE.asEuint64(currentTime))));
    }

    // =============================================================
    // EXECUTION PROGRESS TESTS (25 tests)
    // =============================================================

    function testGetVirtualTimeProgress_StartOfExecution() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        euint64 currentVTime = order.startTime; // At start
        
        euint128 delta = VirtualTimeEngine.getVirtualTimeProgress(order, currentVTime);
        
        // Should be zero at start
        // FHE assertion: assertTrue(FHE.decrypt(FHE.eq(delta, FHE.asEuint128(0))));
    }

    function testGetVirtualTimeProgress_MiddleOfExecution() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        
        // Advance to middle of execution (30 minutes)
        euint64 currentVTime = FHE.add(order.startTime, FHE.asEuint64(HOUR / 2));
        
        euint128 delta = VirtualTimeEngine.getVirtualTimeProgress(order, currentVTime);
        
        // Should be approximately half the total size
        euint128 expectedDelta = FHE.asEuint128(INITIAL_SIZE / 2);
        euint128 tolerance = FHE.asEuint128(INITIAL_SIZE / 100); // 1% tolerance
        
        // FHE assertion: assertTrue(FHE.decrypt(FHE.lt(FHE.sub(delta, expectedDelta), tolerance)));
    }

    function testGetVirtualTimeProgress_EndOfExecution() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        
        // Advance to end of execution
        euint64 currentVTime = FHE.add(order.startTime, order.schedule);
        
        euint128 delta = VirtualTimeEngine.getVirtualTimeProgress(order, currentVTime);
        
        // Should be full size minus already executed
        euint128 expectedDelta = FHE.sub(order.totalSize, order.executedAmount);
        // FHE assertion: assertTrue(FHE.decrypt(FHE.eq(delta, expectedDelta)));
    }

    function testGetVirtualTimeProgress_BeyondExecution() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        
        // Advance beyond execution period
        euint64 currentVTime = FHE.add(order.startTime, FHE.asEuint64(HOUR * 2));
        
        euint128 delta = VirtualTimeEngine.getVirtualTimeProgress(order, currentVTime);
        
        // Should not exceed remaining amount
        euint128 remainingAmount = FHE.sub(order.totalSize, order.executedAmount);
        // FHE assertion: assertTrue(FHE.decrypt(FHE.lte(delta, remainingAmount)));
    }

    function testGetVirtualTimeProgress_PartiallyExecuted() public {
        uint128 executedAmount = INITIAL_SIZE / 4; // 25% executed
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        order.executedAmount = FHE.asEuint128(executedAmount);
        
        // Advance to middle of execution
        euint64 currentVTime = FHE.add(order.startTime, FHE.asEuint64(HOUR / 2));
        
        euint128 delta = VirtualTimeEngine.getVirtualTimeProgress(order, currentVTime);
        
        // Should be approximately 25% more (50% total - 25% executed)
        euint128 expectedDelta = FHE.asEuint128(INITIAL_SIZE / 4);
        euint128 tolerance = FHE.asEuint128(INITIAL_SIZE / 100);
        
        // FHE assertion: assertTrue(FHE.decrypt(FHE.lt(FHE.sub(delta, expectedDelta), tolerance)));
    }

    function testFuzzGetVirtualTimeProgress(uint128 totalSize, uint64 schedule, uint64 timeElapsed) public {
        vm.assume(totalSize > 1000 && totalSize < type(uint128).max / 1e18);
        vm.assume(schedule > 60 && schedule < DAY * 30); // 1 min to 30 days
        vm.assume(timeElapsed <= schedule * 2); // Up to 2x schedule
        
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(totalSize, schedule);
        euint64 currentVTime = FHE.add(order.startTime, FHE.asEuint64(timeElapsed));
        
        euint128 delta = VirtualTimeEngine.getVirtualTimeProgress(order, currentVTime);
        
        // Delta should not exceed total size
        // FHE assertion: assertTrue(FHE.decrypt(FHE.lte(delta, order.totalSize)));
    }

    // =============================================================
    // EXECUTION RATE TESTS (15 tests)
    // =============================================================

    function testCalculateExecutionRate_StandardOrder() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        
        euint128 rate = VirtualTimeEngine.calculateExecutionRate(order, FHE.asEuint64(0));
        
        // Rate should be totalSize / schedule
        euint128 expectedRate = FHE.div(order.totalSize, FHE.asEuint128(order.schedule));
        // FHE assertion: assertTrue(FHE.decrypt(FHE.eq(rate, expectedRate)));
    }

    function testCalculateExecutionRate_LargeOrder() public {
        uint128 largeSize = INITIAL_SIZE * 1000; // Very large order
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(largeSize, HOUR);
        
        euint128 rate = VirtualTimeEngine.calculateExecutionRate(order, FHE.asEuint64(0));
        
        euint128 expectedRate = FHE.div(order.totalSize, FHE.asEuint128(order.schedule));
        // FHE assertion: assertTrue(FHE.decrypt(FHE.eq(rate, expectedRate)));
    }

    function testCalculateExecutionRate_LongDuration() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, DAY);
        
        euint128 rate = VirtualTimeEngine.calculateExecutionRate(order, FHE.asEuint64(0));
        
        euint128 expectedRate = FHE.div(order.totalSize, FHE.asEuint128(order.schedule));
        // FHE assertion: assertTrue(FHE.decrypt(FHE.eq(rate, expectedRate)));
    }

    // =============================================================
    // ORDER COMPLETION TESTS (20 tests)
    // =============================================================

    function testIsOrderComplete_BeforeStart() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        euint64 currentVTime = FHE.sub(order.startTime, FHE.asEuint64(60)); // 1 minute before
        
        ebool isComplete = VirtualTimeEngine.isOrderComplete(order, currentVTime);
        
        assertFalse(FHE.decrypt(isComplete));
    }

    function testIsOrderComplete_AtStart() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        euint64 currentVTime = order.startTime;
        
        ebool isComplete = VirtualTimeEngine.isOrderComplete(order, currentVTime);
        
        assertFalse(FHE.decrypt(isComplete));
    }

    function testIsOrderComplete_DuringExecution() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        euint64 currentVTime = FHE.add(order.startTime, FHE.asEuint64(HOUR / 2));
        
        ebool isComplete = VirtualTimeEngine.isOrderComplete(order, currentVTime);
        
        assertFalse(FHE.decrypt(isComplete));
    }

    function testIsOrderComplete_AtEnd() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        euint64 currentVTime = FHE.add(order.startTime, order.schedule);
        
        ebool isComplete = VirtualTimeEngine.isOrderComplete(order, currentVTime);
        
        // FHE assertion: assertTrue(FHE.decrypt(isComplete));
    }

    function testIsOrderComplete_AfterEnd() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        euint64 currentVTime = FHE.add(order.startTime, FHE.asEuint64(HOUR * 2));
        
        ebool isComplete = VirtualTimeEngine.isOrderComplete(order, currentVTime);
        
        // FHE assertion: assertTrue(FHE.decrypt(isComplete));
    }

    // =============================================================
    // SHOULD EXECUTE TESTS (20 tests)  
    // =============================================================

    function testShouldExecute_BeforeStart() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        euint64 currentVTime = FHE.sub(order.startTime, FHE.asEuint64(60));
        
        ebool shouldExec = VirtualTimeEngine.shouldExecute(order, currentVTime);
        
        assertFalse(FHE.decrypt(shouldExec));
    }

    function testShouldExecute_AtStart() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        euint64 currentVTime = order.startTime;
        
        ebool shouldExec = VirtualTimeEngine.shouldExecute(order, currentVTime);
        
        // FHE assertion: assertTrue(FHE.decrypt(shouldExec));
    }

    function testShouldExecute_DuringExecution() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        euint64 currentVTime = FHE.add(order.startTime, FHE.asEuint64(HOUR / 2));
        
        ebool shouldExec = VirtualTimeEngine.shouldExecute(order, currentVTime);
        
        // FHE assertion: assertTrue(FHE.decrypt(shouldExec));
    }

    function testShouldExecute_AfterEnd() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        euint64 currentVTime = FHE.add(order.startTime, FHE.asEuint64(HOUR * 2));
        
        ebool shouldExec = VirtualTimeEngine.shouldExecute(order, currentVTime);
        
        assertFalse(FHE.decrypt(shouldExec));
    }

    function testShouldExecute_FullyExecuted() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        order.executedAmount = order.totalSize; // Fully executed
        
        euint64 currentVTime = FHE.add(order.startTime, FHE.asEuint64(HOUR / 2));
        
        ebool shouldExec = VirtualTimeEngine.shouldExecute(order, currentVTime);
        
        assertFalse(FHE.decrypt(shouldExec));
    }

    // =============================================================
    // REMAINING TIME TESTS (15 tests)
    // =============================================================

    function testGetRemainingTime_BeforeStart() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        euint64 currentVTime = FHE.sub(order.startTime, FHE.asEuint64(60));
        
        euint64 remainingTime = VirtualTimeEngine.getRemainingTime(order, currentVTime);
        
        // Should be full schedule + extra time
        euint64 expectedRemaining = FHE.add(order.schedule, FHE.asEuint64(60));
        // FHE assertion: assertTrue(FHE.decrypt(FHE.eq(remainingTime, expectedRemaining)));
    }

    function testGetRemainingTime_AtStart() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        euint64 currentVTime = order.startTime;
        
        euint64 remainingTime = VirtualTimeEngine.getRemainingTime(order, currentVTime);
        
        // FHE assertion: assertTrue(FHE.decrypt(FHE.eq(remainingTime, order.schedule)));
    }

    function testGetRemainingTime_MiddleOfExecution() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        euint64 currentVTime = FHE.add(order.startTime, FHE.asEuint64(HOUR / 2));
        
        euint64 remainingTime = VirtualTimeEngine.getRemainingTime(order, currentVTime);
        
        euint64 expectedRemaining = FHE.asEuint64(HOUR / 2);
        // FHE assertion: assertTrue(FHE.decrypt(FHE.eq(remainingTime, expectedRemaining)));
    }

    function testGetRemainingTime_AfterEnd() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        euint64 currentVTime = FHE.add(order.startTime, FHE.asEuint64(HOUR * 2));
        
        euint64 remainingTime = VirtualTimeEngine.getRemainingTime(order, currentVTime);
        
        // FHE assertion: assertTrue(FHE.decrypt(FHE.eq(remainingTime, FHE.asEuint64(0))));
    }

    // =============================================================
    // VIRTUAL TIME UPDATE TESTS (10 tests)
    // =============================================================

    function testUpdateOrderVirtualTime_Basic() public {
        // Note: This tests the interface, actual storage updates would be in main contract
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, HOUR);
        euint64 newVTime = FHE.add(order.startTime, FHE.asEuint64(HOUR / 2));
        
        // This mainly tests the type conversion logic
        euint128 convertedVTime = FHE.asEuint128(newVTime);
        // FHE assertion: assertTrue(FHE.decrypt(FHE.eq(FHE.asEuint64(convertedVTime), newVTime)));
    }

    // =============================================================
    // ERROR CONDITION TESTS (10 tests)
    // =============================================================

    function testGetVirtualTimeProgress_ZeroSchedule() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, 0);
        euint64 currentVTime = order.startTime;
        
        // This should handle division by zero gracefully
        vm.expectRevert(); // FHE division by zero should revert
        VirtualTimeEngine.getVirtualTimeProgress(order, currentVTime);
    }

    function testGetVirtualTimeProgress_ZeroSize() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(0, HOUR);
        euint64 currentVTime = FHE.add(order.startTime, FHE.asEuint64(HOUR / 2));
        
        euint128 delta = VirtualTimeEngine.getVirtualTimeProgress(order, currentVTime);
        
        // FHE assertion: assertTrue(FHE.decrypt(FHE.eq(delta, FHE.asEuint128(0))));
    }

    // =============================================================
    // PRECISION TESTS (20 tests)
    // =============================================================

    function testPrecisionHandling_SmallOrder() public {
        uint128 smallSize = 100; // Very small order
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(smallSize, HOUR);
        
        euint64 currentVTime = FHE.add(order.startTime, FHE.asEuint64(HOUR / 2));
        euint128 delta = VirtualTimeEngine.getVirtualTimeProgress(order, currentVTime);
        
        // Should handle small values correctly
        // FHE assertion: assertTrue(FHE.decrypt(FHE.lte(delta, order.totalSize)));
    }

    function testPrecisionHandling_HighPrecisionSchedule() public {
        VirtualTimeEngine.PhantomTWAMMOrder memory order = _createTestOrder(INITIAL_SIZE, 1); // 1 second
        
        euint64 currentVTime = order.startTime;
        euint128 delta = VirtualTimeEngine.getVirtualTimeProgress(order, currentVTime);
        
        // FHE assertion: assertTrue(FHE.decrypt(FHE.eq(delta, FHE.asEuint128(0))));
    }

    // =============================================================
    // HELPER FUNCTIONS
    // =============================================================

    function _createTestOrder(uint128 size, uint64 schedule) internal returns (VirtualTimeEngine.PhantomTWAMMOrder memory) {
        return VirtualTimeEngine.PhantomTWAMMOrder({
            totalSize: FHE.asEuint128(size),
            direction: FHE.asEuint8(0), // Buy
            schedule: FHE.asEuint64(schedule),
            virtualTime: FHE.asEuint128(0),
            executedAmount: FHE.asEuint128(0),
            lastExecution: FHE.asEuint64(block.timestamp),
            startTime: FHE.asEuint64(block.timestamp),
            isRevealed: FHE.asEbool(false),
            commitmentHash: keccak256("test"),
            trader: trader1,
            settled: false
        });
    }
}