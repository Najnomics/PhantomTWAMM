# PhantomTWAMM Environment Variables
# Copy this file to .env and fill in your values

# Private key for deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC URLs
RPC_URL=https://your-rpc-url.com
MAINNET_RPC=https://mainnet.infura.io/v3/your-project-id
TESTNET_RPC=https://sepolia.infura.io/v3/your-project-id

# Etherscan API keys for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key
SEPOLIA_ETHERSCAN_API_KEY=your_sepolia_etherscan_api_key

# Optional: Existing PoolManager address (if not deploying new one)
POOL_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: Deploy demo pool for testing
DEPLOY_DEMO_POOL=false

# Optional: Gas settings
GAS_PRICE=20000000000
GAS_LIMIT=8000000

# Optional: Fork settings for testing
FORK_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key
FORK_BLOCK_NUMBER=latest
