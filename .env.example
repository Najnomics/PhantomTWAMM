# PhantomTWAMM Environment Variables
# Copy this file to .env and fill in your values

# Deployment Configuration
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80  # Default Anvil account
RPC_URL=http://localhost:8545

# Optional: Use existing deployed contracts
POOL_MANAGER_ADDRESS=
PHANTOM_TWAMM_ADDRESS=

# Demo Configuration
DEPLOY_DEMO_POOL=true

# Demo Accounts (optional, will be generated if not provided)
ALICE_ADDRESS=
BOB_ADDRESS=
CAROL_ADDRESS=

# Demo Tokens (required for demo script)
TOKEN0_ADDRESS=
TOKEN1_ADDRESS=

# Network Configuration
ALCHEMY_KEY=your_alchemy_api_key_here
INFURA_KEY=your_infura_api_key_here

# Fhenix Network
FHENIX_RPC=https://api.helium.fhenix.zone
FHENIX_PRIVATE_KEY=

# Verification (optional)
ETHERSCAN_API_KEY=your_etherscan_api_key